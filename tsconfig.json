{
    "extends": "@tsconfig/node22/tsconfig.json",
    "compilerOptions": {
        "allowJs": true,
        "checkJs": false,
        "noEmit": true,
        "module": "commonjs",
        "moduleResolution": "node",
        "resolveJsonModule": true,
        "esModuleInterop": true,
        "skipLibCheck": true,
        "types": ["node"]
    },
    "include": ["main.js", "lib/**/*.js", "test/**/*.js"],
    "exclude": ["node_modules/**", "www/**", "admin/**", "tools/**"]
}
