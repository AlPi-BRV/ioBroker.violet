{
  "i18n": false,
  "type": "tabs",
  "items": {
    "tabConn": {
      "type": "panel",
      "label": "Verbindung",
      "items": {
        "host": {
          "type": "text",
          "label": "IP-Adresse oder Hostname der Violet",
          "xs": 12,
          "sm": 6,
          "md": 4,
          "lg": 3,
          "xl": 3,
          "tooltip": "z. B. 10.10.3.50 oder 10.10.3.50:8080 (ohne http://)"
        },
        "username": {
          "type": "text",
          "label": "Benutzername",
          "xs": 12,
          "sm": 6,
          "md": 4,
          "lg": 3,
          "xl": 3,
          "tooltip": "Login der Violet-Weboberfläche (für reines Lesen meist nicht nötig)"
        },
        "password": {
          "type": "password",
          "label": "Passwort",
          "repeat": false,
          "visible": true,
          "xs": 12,
          "sm": 6,
          "md": 4,
          "lg": 3,
          "xl": 3
        },
        "interval": {
          "type": "number",
          "label": "Abfrageintervall (Sekunden)",
          "min": 5,
          "max": 3600,
          "newLine": true,
          "xs": 12,
          "sm": 6,
          "md": 4,
          "lg": 3,
          "xl": 3
        },
        "timeout": {
          "type": "number",
          "label": "Zeitlimit pro Abfrage (Sekunden)",
          "min": 2,
          "max": 60,
          "xs": 12,
          "sm": 6,
          "md": 4,
          "lg": 3,
          "xl": 3
        },
        "hdrSwitch": {
          "type": "header",
          "text": "Schalten aus ioBroker",
          "size": 5,
          "newLine": true,
          "xs": 12,
          "sm": 12,
          "md": 12,
          "lg": 12,
          "xl": 12
        },
        "allow_switching": {
          "type": "checkbox",
          "label": "Schalten erlauben (EIN / AUS / AUTO)",
          "newLine": true,
          "xs": 12,
          "sm": 6,
          "md": 4,
          "lg": 3,
          "xl": 3,
          "tooltip": "Legt pro Funktion einen Datenpunkt „schalten“ an. Dosierung, Abdeckung und Einstellungen der Violet sind bewusst nicht schaltbar."
        },
        "switch_duration": {
          "type": "number",
          "label": "Dauer bei manuell EIN/AUS (Minuten)",
          "min": 0,
          "max": 1440,
          "hidden": "!data.allow_switching",
          "xs": 12,
          "sm": 6,
          "md": 4,
          "lg": 3,
          "xl": 3,
          "tooltip": "0 = dauerhaft, bis wieder auf AUTO geschaltet wird"
        },
        "switchNote": {
          "type": "staticText",
          "text": "Zum Schalten werden meist Benutzername und Passwort der Violet benötigt. Nicht schaltbar: Dosierung, Abdeckung, Einstellungen.",
          "hidden": "!data.allow_switching",
          "newLine": true,
          "style": {
            "opacity": 0.75
          },
          "xs": 12,
          "sm": 12,
          "md": 12,
          "lg": 12,
          "xl": 12
        },
        "hdrWeb": {
          "type": "header",
          "text": "Pool-Dashboard",
          "size": 5,
          "newLine": true,
          "xs": 12,
          "sm": 12,
          "md": 12,
          "lg": 12,
          "xl": 12
        },
        "web_enabled": {
          "type": "checkbox",
          "label": "Dashboard bereitstellen",
          "newLine": true,
          "xs": 12,
          "sm": 6,
          "md": 4,
          "lg": 3,
          "xl": 3,
          "tooltip": "Eingebauter Webserver: http://<ioBroker-IP>:<Port>/ – nur im eigenen Netz verwenden, nicht ins Internet freigeben"
        },
        "port": {
          "type": "port",
          "label": "Port",
          "min": 1024,
          "max": 65535,
          "hidden": "!data.web_enabled",
          "xs": 12,
          "sm": 6,
          "md": 4,
          "lg": 3,
          "xl": 3
        },
        "webNote": {
          "type": "staticText",
          "text": "Aufruf: http://<ioBroker-IP>:<Port>/ – Schalter im Dashboard nur, wenn „Schalten erlauben“ aktiv ist. Nur im Heimnetz nutzen.",
          "hidden": "!data.web_enabled",
          "newLine": true,
          "style": {
            "opacity": 0.75
          },
          "xs": 12,
          "sm": 12,
          "md": 12,
          "lg": 12,
          "xl": 12
        }
      }
    },
